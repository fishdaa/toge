import { VerticalBox, LineEdit, Button, StandardTableView, AboutSlint, Palette, ScrollView } from "std-widgets.slint";

component ContextMenuItem {
    in property <string> label;
    callback activated;
    width: 100%; height: 30px;

    highlight := Rectangle {
        x: 4px; y: 1px;
        width: parent.width - 8px; height: parent.height - 2px;
        background: Palette.foreground;
        opacity: touch-area.has-hover ? 0.10 : 0;
        border-radius: 3px;
    }
    Text {
        x: 14px; width: parent.width - 28px; height: parent.height;
        text: root.label;
        color: Palette.foreground;
        vertical-alignment: center;
        font-size: 13px;
    }
    touch-area := TouchArea {
        width: 100%; height: 100%;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component AccessWindow inherits Window {
    title: "Toge — Live updates";
    preferred-width: 460px; preferred-height: 320px;
    min-width: 420px; min-height: 300px;
    background: Palette.background;
    in property <bool> granting: false;
    in property <string> message: "";
    callback approve();
    callback cancel();
    VerticalLayout {
        padding: 24px; spacing: 16px;
        Text { text: "Enable live file updates?"; font-size: 21px; font-weight: 700; color: Palette.foreground; }
        Text {
            text: "Toge needs administrator approval to monitor filesystem changes and keep search results up to date.";
            wrap: word-wrap; color: Palette.foreground;
        }
        Text {
            text: "This grants elevated filesystem access to the Toge background service. Approval applies to this build; rebuilding may require approval again.";
            wrap: word-wrap; color: Palette.foreground;
        }
        Text {
            text: root.granting ? "Waiting for system approval…" : root.message;
            wrap: word-wrap; color: Palette.foreground;
        }
        HorizontalLayout {
            spacing: 12px;
            Button { text: "Cancel"; enabled: !root.granting; clicked => { root.cancel(); } }
            Button { text: root.granting ? "Waiting…" : "Enable live updates"; enabled: !root.granting; clicked => { root.approve(); } }
        }
    }
}

export component AboutWindow inherits Window {
    title: "About Toge";
    width: 360px; height: 270px;
    VerticalBox {
        padding: 24px; spacing: 16px;
        Text { text: "Toge"; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "Fast local file search"; horizontal-alignment: center; }
        AboutSlint { }
    }
}

export component AppWindow inherits Window {
    title: "Toge";
    preferred-width: 900px; preferred-height: 580px;
    min-width: 560px; min-height: 300px;
    background: Palette.background;
    in property <[[StandardListViewItem]]> rows;
    in property <string> status: "Connecting to index…";
    in property <bool> busy: true;
    in property <bool> has-error: false;
    in-out property <int> selected: -1;
    in-out property <bool> context-menu-open: false;
    in-out property <length> context-menu-x: 0px;
    in-out property <length> context-menu-y: 0px;
    in-out property <int> sort-column: -1;
    in-out property <bool> sort-ascending: true;
    in-out property <int> rename-row: -1;
    in-out property <string> rename-path;
    in-out property <string> rename-name;
    in-out property <bool> rename-working: false;
    private property <int> rename-selection-end;
    callback rename-commit(string);
    callback query-edited(string);
    callback submit(string);
    callback sort-results(int, bool);
    callback action(string);
    callback row-clicked(int);
    callback about();
    forward-focus: search;
    public function select-row(index: int) {
        root.selected = index;
        selection-scroll.start();
    }
    public function apply-sort(column: int, ascending: bool) {
        root.cancel-rename(false);
        root.context-menu-open = false;
        root.sort-column = column;
        root.sort-ascending = ascending;
        table.columns[0].sort-order = column == 0 ? (ascending ? SortOrder.ascending : SortOrder.descending) : SortOrder.unsorted;
        table.columns[1].sort-order = column == 1 ? (ascending ? SortOrder.ascending : SortOrder.descending) : SortOrder.unsorted;
        table.columns[2].sort-order = column == 2 ? (ascending ? SortOrder.ascending : SortOrder.descending) : SortOrder.unsorted;
        table.columns[3].sort-order = column == 3 ? (ascending ? SortOrder.ascending : SortOrder.descending) : SortOrder.unsorted;
    }
    public function begin-rename(index: int, name: string, selection-end: int) {
        root.rename-row = index;
        root.rename-name = name;
        root.rename-selection-end = selection-end;
        root.context-menu-open = false;
        table.viewport-x = 0px;
        table.set-current-row(index);
        rename-focus.start();
    }
    public function focus-rename() { inline-name.focus(); }
    public function cancel-rename(return-focus: bool) {
        if (root.rename-working) { return; }
        rename-focus.stop();
        root.rename-row = -1;
        root.rename-path = "";
        root.rename-name = "";
        if (return-focus) { table.focus(); }
    }
    rename-focus := Timer {
        interval: 1ms;
        triggered => {
            self.stop();
            if (root.rename-row >= 0) {
                inline-name.focus();
                inline-name.set-selection-offsets(0, root.rename-selection-end);
            }
        }
    }

    // Wait for the new result model to lay out before calculating scroll offsets.
    selection-scroll := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.stop();
            if (root.selected <= 0) { table.viewport-y = 0px; }
            // set-current-row leaves the final row partly below the viewport.
            else if (root.selected == root.rows.length - 1) {
                table.set-current-row(root.selected);
                table.viewport-y = min(0px, table.visible-height - table.viewport-height);
                bottom-settle.start();
            }
            else { table.set-current-row(root.selected); }
        }
    }

    // The virtual table re-estimates its height after jumping to the end;
    // pin the viewport to the bottom again once that layout has settled.
    bottom-settle := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.stop();
            if (root.rows.length > 0 && root.selected == root.rows.length - 1) {
                table.viewport-y = min(0px, table.visible-height - table.viewport-height);
            }
        }
    }

    FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "l") {
                root.cancel-rename(false); search.focus(); search.select-all(); return accept;
            }
            return reject;
        }
        VerticalLayout {
            width: 100%; height: 100%; spacing: 0px;
            Rectangle {
                height: 64px;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px;
                    padding-top: 14px; padding-bottom: 14px; spacing: 12px;
                    Rectangle {
                        width: logo.preferred-width;
                        accessible-role: button;
                        accessible-label: "About Toge";
                        logo := Text {
                            text: "toge"; font-size: 19px; font-weight: 700;
                            color: Palette.foreground; vertical-alignment: center;
                        }
                        TouchArea {
                            width: 100%; height: 100%; mouse-cursor: pointer;
                            clicked => { root.cancel-rename(false); root.context-menu-open = false; root.about(); }
                        }
                    }
                    search := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Search files and folders…";
                        enabled: !root.rename-working;
                        edited(text) => { root.cancel-rename(false); root.query-edited(text); }
                        accepted(text) => { root.submit(text); }
                    }
                    if root.has-error: Button {
                        text: "Retry";
                        clicked => { root.submit(search.text); }
                    }
                }
            }
            Rectangle { height: 1px; background: Palette.foreground; opacity: 0.10; }
            keys := FocusScope {
                vertical-stretch: 1;
                forward-focus: table;
                key-pressed(event) => {
                    // Let the inline field handle text shortcuts and Enter itself.
                    if (root.rename-path != "") { return reject; }
                    if (event.text == Key.Return) { root.action("open"); return accept; }
                    if (event.modifiers.control && event.text == "c") { root.action(event.modifiers.shift ? "copy-path" : "copy"); return accept; }
                    if (event.modifiers.control && event.text == "x") { root.action("cut"); return accept; }
                    if (event.text == Key.F2) { root.action("rename"); return accept; }
                    if (event.text == Key.Delete) { root.action("delete"); return accept; }
                    if (event.text == Key.Escape) { root.context-menu-open = false; return accept; }
                    // StandardTableView handles only Up/Down itself.
                    if (root.rows.length > 0) {
                        if (event.text == Key.Home) { root.select-row(0); return accept; }
                        if (event.text == Key.End) { root.select-row(root.rows.length - 1); return accept; }
                        if (event.text == Key.PageDown) {
                            root.select-row(min(root.rows.length - 1, max(0, root.selected) + self.page-rows));
                            return accept;
                        }
                        if (event.text == Key.PageUp) {
                            root.select-row(max(0, root.selected - self.page-rows));
                            return accept;
                        }
                    }
                    return reject;
                }
                // Rows that fit in the viewport, less one so a page step keeps context.
                property <int> page-rows: max(1, floor(table.visible-height / max(1px, table.viewport-height / max(1, root.rows.length))) - 1);
                table := StandardTableView {
                    width: 100%; height: 100%;
                    rows: root.rows;
                    enabled: !root.rename-working;
                    current-row <=> root.selected;
                    columns: [
                        { title: "Name", width: 220px, min-width: 140px },
                        { title: "Path", width: 340px, min-width: 160px },
                        { title: "Size", width: 90px, min-width: 70px },
                        // Fill the remaining width even before any rows are loaded.
                        { title: "Modified", width: 0px, min-width: 150px, horizontal-stretch: 1 }
                    ];
                    sort-ascending(column) => { root.sort-results(column, true); }
                    sort-descending(column) => { root.sort-results(column, false); }
                    row-pointer-event(index, event, position) => {
                        if (event.kind == PointerEventKind.down) { root.cancel-rename(false); }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            root.selected = index;
                            table.focus();
                            root.context-menu-x = position.x;
                            root.context-menu-y = position.y;
                            root.context-menu-open = true;
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.context-menu-open = false;
                            // Move keyboard focus off the search field so arrow keys,
                            // Enter and shortcuts act on the clicked row.
                            table.focus();
                            root.selected = index; root.row-clicked(index);
                        }
                    }
                }
                // StandardTableView's selection fill can match its row stripes.
                // Tint only the selected row, using the same virtual row geometry
                // as the table's own scrolling and keyboard selection.
                if root.selected >= 0 && root.selected < root.rows.length: Rectangle {
                    x: 0px; y: table.height - table.visible-height;
                    width: table.visible-width; height: table.visible-height;
                    clip: true;
                    Rectangle {
                        y: table.viewport-y + root.selected * self.height;
                        width: parent.width;
                        height: table.viewport-height / max(1, root.rows.length);
                        background: Palette.selection-background;
                        opacity: 0.32;
                    }
                }
                // Use the table's own viewport geometry so the editor follows
                // the Name cell through scrolling, column resizing, and window resizing.
                Rectangle {
                    visible: root.rename-row >= 0;
                    x: 0px; y: table.height - table.visible-height;
                    width: table.visible-width; height: table.visible-height;
                    clip: true;
                    inline-name := LineEdit {
                        x: table.viewport-x + 4px;
                        y: table.viewport-y + root.rename-row * (table.viewport-height / max(1, root.rows.length)) + 1px;
                        width: max(table.columns[0].width, table.columns[0].min-width) - 8px;
                        height: max(1px, table.viewport-height / max(1, root.rows.length) - 2px);
                        text <=> root.rename-name;
                        enabled: !root.rename-working;
                        accepted(text) => { root.rename-commit(text); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) { root.cancel-rename(true); return accept; }
                            return reject;
                        }
                        changed has-focus => {
                            if (!self.has-focus && root.rename-path != "" && !root.rename-working) {
                                root.cancel-rename(false);
                            }
                        }
                    }
                }
                if root.rows.length == 0: Rectangle {
                    // StandardTableView keeps a roughly 42px header above its body.
                    // Keep the empty state in the body so it does not overlap the headings.
                    x: 0px; y: 42px;
                    width: parent.width; height: parent.height - 42px;
                    background: transparent;
                    VerticalLayout {
                        x: 24px; width: parent.width - 48px;
                        height: self.preferred-height;
                        y: (parent.height - self.height) / 2;
                        spacing: 8px;
                        Text {
                            text: root.has-error ? "Couldn’t load results" : root.busy ? "Preparing your search" : "No matches";
                            font-size: 18px; font-weight: 600;
                            horizontal-alignment: center;
                            color: Palette.foreground;
                        }
                        Text {
                            text: root.has-error ? "Check the status below and try again." : root.busy ? "Results will appear when the index is ready." : "Try another name, or use ext:pdf or path:src.";
                            horizontal-alignment: center;
                            color: Palette.foreground; opacity: 0.55;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.context-menu-open: TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.context-menu-open = false; }
                }
                if root.context-menu-open: Rectangle {
                    x: max(8px, min(root.context-menu-x, parent.width - self.width - 8px));
                    y: max(8px, min(root.context-menu-y, parent.height - self.height - 8px));
                    width: 184px; height: min(229px, parent.height - 16px);
                    background: Palette.background;
                    border-width: 1px;
                    border-color: Palette.foreground;
                    border-radius: 4px;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #40000000;
                    ScrollView {
                      width: parent.width; height: parent.height;
                      viewport-width: self.visible-width;
                      VerticalLayout {
                        height: 229px;
                        padding-top: 5px; padding-bottom: 5px;
                        spacing: 1px;
                        ContextMenuItem {
                            label: "Open";
                            activated => { root.context-menu-open = false; root.action("open"); }
                        }
                        ContextMenuItem {
                            label: "Copy path";
                            activated => { root.context-menu-open = false; root.action("copy-path"); }
                        }
                        ContextMenuItem {
                            label: "Open folder";
                            activated => { root.context-menu-open = false; root.action("parent"); }
                        }
                        Rectangle {
                            height: 1px;
                            background: Palette.foreground;
                            opacity: 0.12;
                        }
                        ContextMenuItem { label: "Copy"; activated => { root.context-menu-open = false; root.action("copy"); } }
                        ContextMenuItem { label: "Cut"; activated => { root.context-menu-open = false; root.action("cut"); } }
                        ContextMenuItem { label: "Rename"; activated => { root.context-menu-open = false; root.action("rename"); } }
                        ContextMenuItem { label: "Delete"; activated => { root.context-menu-open = false; root.action("delete"); } }
                      }
                    }
                }
            }
            Rectangle { height: 1px; background: Palette.foreground; opacity: 0.10; }
            Rectangle {
                height: 36px;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 5px; padding-bottom: 5px;
                    Text {
                        text: root.status; overflow: elide;
                        horizontal-stretch: 1; font-size: 12px;
                        color: Palette.foreground; opacity: 0.65;
                    }
                }
            }
        }
    }
}
